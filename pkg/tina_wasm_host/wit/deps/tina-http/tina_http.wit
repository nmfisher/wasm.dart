// The `tina:http` host interface: the engine's HTTP port
// (`tina_core.HttpClientPort`) served by the host instead of `dart:io`.
//
// One function covers the port's POST and GET: the method travels in the
// request. The response head (status + headers) arrives first; the body is
// a component-model byte stream the guest reads incrementally, paired with
// a future resolving once the whole body has been delivered - the same
// shape as `wasi:cli/stdin.read-via-stream`, so guests lower it with the
// stream/future machinery they already use for stdio.
package tina:http@1.0.0;

interface types {
    /// One outgoing request. `method` is `GET` or `POST` (upper-case, as
    /// `dart:io` sends it); `url` is absolute; `body` is the request body
    /// or none for GET.
    record request {
        method: string,
        url: string,
        headers: list<tuple<string, string>>,
        body: option<list<u8>>,
    }

    /// The response before its body: status code plus header pairs. Header
    /// names keep the case the server sent.
    record response-head {
        status: u16,
        headers: list<tuple<string, string>>,
    }

    /// Why a request failed before any body: a host-side message, never a
    /// raw OS error, so guests can surface it verbatim.
    variant error {
        message(string),
    }
}

interface client {
    use types.{request, response-head, error};

    /// Issue `req`. The call is async: it completes when the response
    /// head is available, and hands back
    ///
    /// - the head (status + headers),
    /// - the body as a byte stream, in order, chunked as the network
    ///   delivers it, and
    /// - a future that resolves with an error when the body transfer
    ///   failed, and successfully once every body byte was delivered.
    ///
    /// Dropping the stream cancels the transfer.
    send: async func(req: request) -> result<tuple<response-head, stream<u8>, future<result<_, error>>>, error>;
}

/// The host-side world used to generate the Rust bindings for the
/// interface. It deliberately contains nothing else: the runner links WASI
/// separately through `wasmtime_wasi::p3::add_to_linker`, so this world
/// only describes the custom host import.
world tina-http-host {
    import client;
}
